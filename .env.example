# Chave da API Anthropic (obrigatorio)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Porta do servidor (opcional, padrao: 3000)
PORT=3000

# Nota sobre armazenamento:
# - Local: dados salvos em data/dossies.json (criado automaticamente)
# - Vercel: dados salvos em /tmp (efemero, reseta a cada deploy/cold start)
# Para persistencia em producao, adicione um banco de dados externo.
