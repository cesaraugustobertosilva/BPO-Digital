# Chave da API Anthropic (obrigatorio)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Porta do servidor (opcional, padrao: 3000)
PORT=3000

# Segredo para assinar tokens JWT (recomendado trocar em producao)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Armazenamento persistente via GitHub Contents API (recomendado para Vercel)
# Crie um Personal Access Token em: https://github.com/settings/tokens
# Permissoes necessarias: Contents (read & write) no repositorio abaixo
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=cesaraugustobertosilva
GITHUB_REPO=BPO-Digital
# Os dados serao salvos no branch "data" do repositorio acima.

# Sem GITHUB_TOKEN: dados salvos localmente em data/*.json (apenas desenvolvimento)
# Com GITHUB_TOKEN:  dados salvos no GitHub e persistem entre deploys no Vercel
